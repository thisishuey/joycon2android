+package com.joegec.joycon2android.connection
+
+import com.joegec.joycon2android.model.JoyconButton
+import com.joegec.joycon2android.model.JoyconInput
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RawPacketFormatTest {
+
+    @Test
+    fun `a parsed packet lists its decoded fields before the raw bytes`() {
+        val input = JoyconInput(
+            buttons = 0x800,
+            pressed = setOf(JoyconButton.A.id),
+            stickX = 100, stickY = 200, rightStickX = 300, rightStickY = 400,
+            triggerLeft = 7, triggerRight = 8,
+        )
+        val line = RawPacketFormat.describe(byteArrayOf(0x01, 0xAB.toByte()), input)
+        assertEquals(
+            "btn=0000000800 L=100,200 R=300,400 trig=7,8 pressed=${JoyconButton.A.id} len=2 raw=01 AB",
+            line,
+        )
+    }
+
+    @Test
+    fun `an unparsed packet still shows its raw bytes`() {
+        val line = RawPacketFormat.describe(byteArrayOf(0x0F), null)
+        assertTrue(line.startsWith("unparsed len=1 raw=0F"))
+    }
+}
