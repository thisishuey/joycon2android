+package com.joegec.joycon2android.connection
+
+import kotlin.math.abs
+
+/** Passes a packet only when its input bytes moved, so a raw capture isn't IMU and stick noise. */
+class PacketChangeFilter(
+    private val stickTolerance: Int = DEFAULT_STICK_TOLERANCE,
+    private val triggerTolerance: Int = DEFAULT_TRIGGER_TOLERANCE,
+) {
+
+    private var last: Snapshot? = null
+
+    fun isNewInput(data: ByteArray): Boolean {
+        if (data.size <= TRIGGER_RIGHT) return false
+        val current = Snapshot.of(data)
+        val previous = last
+        if (previous != null && !current.differsFrom(previous)) return false
+        last = current
+        return true
+    }
+
+    private fun Snapshot.differsFrom(other: Snapshot): Boolean =
+        !buttonBytes.contentEquals(other.buttonBytes) ||
+            sticks.indices.any { abs(sticks[it] - other.sticks[it]) > stickTolerance } ||
+            triggers.indices.any { abs(triggers[it] - other.triggers[it]) > triggerTolerance }
+
+    private class Snapshot(val buttonBytes: ByteArray, val sticks: IntArray, val triggers: IntArray) {
+        companion object {
+            fun of(data: ByteArray) = Snapshot(
+                buttonBytes = data.copyOfRange(BUTTONS_START, BUTTONS_END),
+                sticks = intArrayOf(
+                    stickX(data, LEFT_STICK), stickY(data, LEFT_STICK),
+                    stickX(data, RIGHT_STICK), stickY(data, RIGHT_STICK),
+                ),
+                triggers = intArrayOf(
+                    data[TRIGGER_LEFT].toInt() and 0xFF,
+                    data[TRIGGER_RIGHT].toInt() and 0xFF,
+                ),
+            )
+
+            private fun packed(data: ByteArray, offset: Int): Int =
+                (data[offset].toInt() and 0xFF) or
+                    ((data[offset + 1].toInt() and 0xFF) shl 8) or
+                    ((data[offset + 2].toInt() and 0xFF) shl 16)
+
+            private fun stickX(data: ByteArray, offset: Int) = packed(data, offset) and 0xFFF
+            private fun stickY(data: ByteArray, offset: Int) = (packed(data, offset) shr 12) and 0xFFF
+        }
+    }
+
+    private companion object {
+        const val DEFAULT_STICK_TOLERANCE = 24
+        const val DEFAULT_TRIGGER_TOLERANCE = 3
+
+        // Buttons, back paddles and the two unmapped bytes before the left stick.
+        const val BUTTONS_START = 0x03
+        const val BUTTONS_END = 0x0A
+        const val LEFT_STICK = 0x0A
+        const val RIGHT_STICK = 0x0D
+        const val TRIGGER_LEFT = 0x3C
+        const val TRIGGER_RIGHT = 0x3D
+    }
+}
