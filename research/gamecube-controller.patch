@@ -0,0 +1,19 @@
+package com.joegec.joycon2android.connection
+
+import com.joegec.joycon2android.model.JoyconInput
+
+/** One capture line per packet: docs/protocol.md#capturing-raw-packets */
+object RawPacketFormat {
+
+    fun describe(data: ByteArray, input: JoyconInput?): String {
+        val fields = input?.let {
+            "btn=%010X L=%d,%d R=%d,%d trig=%d,%d pressed=%s".format(
+                it.buttons, it.stickX, it.stickY, it.rightStickX, it.rightStickY,
+                it.triggerLeft, it.triggerRight, it.pressed.sorted().joinToString("+").ifEmpty { "-" },
+            )
+        } ?: "unparsed"
+        return "$fields len=${data.size} raw=${hex(data)}"
+    }
+
+    private fun hex(data: ByteArray): String = data.joinToString(" ") { "%02X".format(it) }
+}
